// bubble sort on an int array
int a[7] = {29, 3, 17, 8, 42, 1, 11};
int n = 7;
int i = 0;
int j = 0;
int t = 0;
int swaps = 0;
while (i < n - 1) {
    j = 0;
    while (j < n - 1 - i) {
        if (a[j] > a[j + 1]) {
            t = a[j];
            a[j] = a[j + 1];
            a[j + 1] = t;
            swaps = swaps + 1;
        }
        j = j + 1;
    }
    i = i + 1;
}
print a;
print swaps;
